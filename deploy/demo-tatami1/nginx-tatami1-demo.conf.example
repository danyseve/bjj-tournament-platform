# ==============================================================================
# PLANTILLA — NO ACTIVA (documental)
#
# Publicación de Tatami 1 por HOSTNAME PROPIO, según la arquitectura vinculante
# de OpsForge:  Cloudflare -> tatami1.opsforge.cc -> Access/OTP
#               -> tunnel opsforge-oracle -> nginx -> scoreboard-tatami-1:3000
#
# Esta plantilla es la versión documental de `nginx/conf.d/tatami1.conf`, que es
# el fichero REAL y activo del frontal productivo. Si se edita uno, hay que
# editar el otro para que no diverjan.
#
# HISTÓRICO (por qué NO se usa el diseño por prefijo de path): en P2.6A se
# diseñó y validó una variante que servía el scoreboard bajo `/tatami/1/` dentro
# del server de Bracket (`server_name bjj.local`) y retiraba el prefijo con
# `proxy_pass .../`. Se descartó: `opsforge.cc` es solo la landing y cada
# aplicación publicable tiene su propio hostname, de modo que
# `opsforge.cc/tatami/1/...` (o `bjjvetusta.../tatami/1/...`) no puede ser el
# acceso final. Con un hostname dedicado el scoreboard queda en la RAÍZ y no hay
# que retirar ningún prefijo.
#
# NO copiar a nginx/conf.d/ : ese directorio está montado en el nginx productivo
# y cualquier fichero `*.conf` allí se activa al recargar.
# ==============================================================================

server {
    listen 80;
    server_name tatami1.opsforge.cc;

    # El scoreboard no recibe subidas: límite modesto.
    client_max_body_size 5m;

    # Socket.IO / WebSocket: upgrade real y sin buffering.
    location /socket.io/ {
        proxy_pass http://scoreboard-tatami-1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Resto del scoreboard: marcador, /control, /css/, /js/, /images/, manifest.
    location / {
        proxy_pass http://scoreboard-tatami-1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # El resto de peticiones no son upgrades: no forzar Connection.
        proxy_set_header Connection "";

        proxy_read_timeout 60s;
    }
}

# Notas operativas
# ----------------
# 1) El server de BJJ (`nginx/conf.d/bjj.conf`) NO se toca y sigue siendo el
#    server por defecto: `conf.d` se incluye en orden alfabético (bjj.conf <
#    tatami1.conf), así que un Host no reconocido sigue yendo a Bracket.
# 2) nginx resuelve `scoreboard-tatami-1` al cargar la configuración: si el
#    contenedor del scoreboard se recrea (IP nueva), hace falta `nginx -s reload`
#    aunque el nombre DNS sea el mismo.
# 3) Este server solo responde si el Host ya llega con ese nombre. Sin registro
#    DNS ni ingress en el túnel, el hostname NO es alcanzable desde Internet.
