# ==================================================
# BJJ Tournament Platform - Example Environment File
# ==================================================

# General
PROJECT_NAME=bjj-tournament-platform
ENVIRONMENT=cloud-lab

# Bracket
BRACKET_PORT=8400
BRACKET_API_URL=http://bracket:8400/api
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# PostgreSQL
POSTGRES_DB=bracket_dev
POSTGRES_USER=bracket_dev
POSTGRES_PASSWORD=BracketOracleDemo2026!

# Bridge API
BRIDGE_PORT=8500
BRIDGE_API_KEY=change_me

# Scoreboards - one instance per tatami
SCOREBOARD_TATAMI_1_PORT=3001
SCOREBOARD_TATAMI_2_PORT=3002
SCOREBOARD_TATAMI_3_PORT=3003
SCOREBOARD_TATAMI_4_PORT=3004
SCOREBOARD_TATAMI_5_PORT=3005
SCOREBOARD_TATAMI_6_PORT=3006

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# WireGuard
# ==================================================
# WireGuard VPN - Oracle Cloud A1
# ==================================================

# Public IP or DNS name of the Oracle Cloud instance
WG_SERVER_URL=143.47.47.86

# WireGuard UDP port
WG_SERVER_PORT=51820

# Number of client profiles to generate
WG_PEERS=10

# DNS used by VPN clients
WG_PEERDNS=1.1.1.1

# WireGuard internal VPN subnet.
# Do not use 10.0.0.0 because Oracle VCN is using 10.0.0.x.
WG_INTERNAL_SUBNET=10.8.0.0

# Full tunnel mode.
# 0.0.0.0/0 means VPN clients route all traffic through Oracle instance.
WG_ALLOWEDIPS=0.0.0.0/0

# Container user/group
PUID=1001
PGID=1001
TZ=Europe/Madrid
# Bracket custom image/public frontend URL
BRACKET_PUBLIC_BASE_URL=http://bjj-bracket.local:8400
BRACKET_IMAGE=danyseve/bracket-bjj:0.1.0
