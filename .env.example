# ==================================================
# BJJ Tournament Platform - Example Environment File
# ==================================================

# General
PROJECT_NAME=bjj-tournament-platform
ENVIRONMENT=local

# Bracket
BRACKET_PORT=8400
BRACKET_API_URL=http://bracket:8400/api
BRACKET_IMAGE=danyseve1/bracket-bjj:0.0.0-placeholder
BRACKET_PUBLIC_BASE_URL=http://localhost:8400
JWT_SECRET=change_me_please_generate_real_secret

# PostgreSQL
POSTGRES_DB=bracket_dev
POSTGRES_USER=bracket_dev
POSTGRES_PASSWORD=change_me

# Bridge API
BRIDGE_PORT=8500
BRIDGE_API_KEY=change_me
# Credenciales propias del Bridge para escribir en Bracket (P2.4D).
# No reutilizan las del navegador; el JWT se canjea con POST /token y no se registra.
# Opcionales: con BRACKET_RESULT_WRITE_ENABLED=false el Bridge arranca sin ellas.
BRACKET_WRITE_USERNAME=change_me
BRACKET_WRITE_PASSWORD=change_me

# Release de Tatami 1 (P2.5B). Solo nombres y placeholders: los valores reales
# viven en el .env del host (600), nunca en Git.
# BRACKET_RESULT_WRITE_ENABLED=false es el unico valor seguro hoy: con false el
# endpoint de resultado responde 503 result_write_disabled sin leer el scoreboard
# ni llamar a Bracket. Cambiarlo a true exige credenciales de escritura.
BRACKET_RESULT_WRITE_ENABLED=false
SCOREBOARD_TATAMI_1_URL=http://scoreboard-tatami-1:3000
# Token interno compartido Bridge<->scoreboard (cabecera X-Internal-Token).
SCOREBOARD_INTERNAL_TOKEN=change_me_internal_token
# Token de control de la UI del scoreboard (mandos del tatami).
SCOREBOARD_CONTROL_TOKEN=change_me_control_token
# Fichero de estado del Tatami 1 dentro del contenedor (mount /state del host).
SCOREBOARD_STATE_FILE=/state/state.json

# Scoreboards - one instance per tatami
SCOREBOARD_TATAMI_1_PORT=3001
SCOREBOARD_TATAMI_2_PORT=3002
SCOREBOARD_TATAMI_3_PORT=3003
SCOREBOARD_TATAMI_4_PORT=3004
SCOREBOARD_TATAMI_5_PORT=3005
SCOREBOARD_TATAMI_6_PORT=3006

# Nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=443

# Host / contenedores (PUID/PGID/TZ)
PUID=1001
PGID=1001
TZ=Europe/Madrid

# WireGuard
WG_PORT=51820
WG_SERVER_URL=vpn.example.com
WG_SERVER_PORT=51820
WG_PEERS=10
WG_PEERDNS=1.1.1.1
WG_INTERNAL_SUBNET=10.8.0.0
WG_ALLOWEDIPS=0.0.0.0/0
